# Скопируйте в .env и задайте значения. Сам .env в git не попадает (.gitignore).
DB_PASSWORD=
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
APP_TZ=Asia/Qostanay
APP_PORT=8000
SESSION_DAYS=30
# проверка веса при вводе брутто (ADR-003); false – выключить
WEIGHT_CHECK=true
# true, если приложение работает за HTTPS (профиль https)
COOKIE_SECURE=false
# домен для HTTPS через Caddy
DOMAIN=localhost
