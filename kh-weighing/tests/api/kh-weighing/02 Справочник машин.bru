meta {
  name: 02 Справочник машин
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/vehicles
  auth: none
}

tests {
  test("200 и 4 машины МТЗ", function() {
    expect(res.status).to.equal(200);
    expect(res.body.length).to.equal(4);
  });
  bru.setVar("vehicleId", res.body[0].id);
  bru.setVar("tareKg", res.body[0].tare_kg);
}
