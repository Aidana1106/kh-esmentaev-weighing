meta {
  name: 01 Вход
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  { "login": "{{login}}", "password": "{{password}}" }
}

tests {
  test("вход успешен", function() { expect(res.status).to.equal(200); });
  test("роль вернулась", function() { expect(res.body.role).to.be.oneOf(["operator", "admin"]); });
}
