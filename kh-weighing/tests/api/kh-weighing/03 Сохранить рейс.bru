meta {
  name: 03 Сохранить рейс
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/trips/{{tripId}}
  body: json
  auth: none
}

body:json {
  { "vehicle_id": {{vehicleId}}, "field_id": 1, "gross_kg": 25400 }
}

script:pre-request {
  const { v4 } = require("uuid");
  bru.setVar("tripId", v4());
}

tests {
  test("рейс создан (201)", function() { expect(res.status).to.equal(201); });
  test("нетто = брутто − тара", function() {
    expect(res.body.net_kg).to.equal(25400 - bru.getVar("tareKg"));
  });
}
